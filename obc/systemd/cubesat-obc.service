# Install:  sudo cp cubesat-obc.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now cubesat-obc
# Logs:     journalctl -u cubesat-obc -f
[Unit]
Description=CubeSat OBC flight software
After=multi-user.target

[Service]
Type=notify
User=pi
WorkingDirectory=/home/pi/cubesat/code/obc
ExecStart=/usr/bin/python3 -m cubesat_obc --config /home/pi/cubesat/code/obc/config/obc.toml run
Restart=always
RestartSec=5
# The app sends WATCHDOG=1 every tick (1 s). If it hangs for 30 s, systemd restarts it.
WatchdogSec=30
NotifyAccess=main

[Install]
WantedBy=multi-user.target
