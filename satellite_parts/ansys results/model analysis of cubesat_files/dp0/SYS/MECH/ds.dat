*get,_wallbsol,active,,time,wall
/solu
antype,2                   ! modal analysis
_thickRatio=0.615   ! Ratio of thick parts in the model
thexpand,off     ! ignore thermal strains
modopt,lanb,8
outres,erase
outres,all,none
outres,nsol,all
