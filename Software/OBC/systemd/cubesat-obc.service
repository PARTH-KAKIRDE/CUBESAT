# Install:  sudo cp OBC/systemd/cubesat-obc.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now cubesat-obc
# Logs:     journalctl -u cubesat-obc -f
# Assumes the Software/ folder is at /home/pi/cubesat/Software.
[Unit]
Description=CubeSat OBC flight software
After=multi-user.target

[Service]
Type=notify
User=pi
WorkingDirectory=/home/pi/cubesat/Software
ExecStart=/usr/bin/python3 -m OBC --config /home/pi/cubesat/Software/OBC/config/obc.toml run
Restart=always
RestartSec=5
# The app sends WATCHDOG=1 every tick (1 s). If it hangs for 30 s, systemd restarts it.
WatchdogSec=30
NotifyAccess=main
# SIGTERM lets the OBC stop a running capture and flush the payload log.
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
